# Адрес сервера
URL_SERVER=https://example.local

# ИНН, разделённые запятыми
VALID_INN=1234567890,123456789012

# ИНН, для которых обработка отключена
DISABLED_INN=9876543210,987654321098

# Версия приложения
VERSION=1.0.0

# Путь к компилятору Inno Setup (если отличается от стандартного)
ISCC_PATH=C:\Program Files (x86)\Inno Setup 6\ISCC.exe

# Параметры подписи — только для локального использования
SIGN_CERT_PATH=C:\example\path\to\sert\example.pfx
SIGN_CERT_PASSWORD=password
SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x86\signtool.exe

# Публикация на внутренний сервер
SEND_BUILD=false
UPDATE_SERVER_PATH=\\example\path\to\zip
UPDATE_INSTALLER_PATH=\\example\path\to\exeinstaller
